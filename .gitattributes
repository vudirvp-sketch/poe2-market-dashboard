# Ensure Windows batch files always use CRLF line endings.
# Unix LF in .bat files causes CMD to mis-parse setlocal/if blocks,
# producing errors like 'd', 'EM', 'tlocal' on Windows.
*.bat text eol=crlf
*.cmd text eol=crlf

# Auto-detect text files and normalize LF in the repo
* text=auto

# Binary files — do not touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp3 binary
*.mp4 binary
*.webp binary
