# Enforce CRLF line endings for Windows batch files.
# Without this, Git may convert to LF on checkout, which causes CMD to
# crash with 'd', 'EM', 'tlocal' parse errors on setlocal/if blocks.
*.bat text eol=crlf
*.cmd text eol=crlf

# Auto-detect text files and normalize LF for everything else
* text=auto
