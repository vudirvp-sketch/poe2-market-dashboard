# PoE2 Market Dashboard — Environment Variables
# Copy this file to .env.local and adjust values as needed.

# POE2Scout API base URL.
# IMPORTANT: Use https://api.poe2scout.com/api (with "api." subdomain).
# The bare domain https://poe2scout.com/api causes ECONNRESET errors!
POE2_API_BASE_URL=https://api.poe2scout.com/api

# Flipper backend URL (FastAPI, default: localhost:8000)
# Uncomment if your backend runs on a different host/port:
# FLIPPER_API_URL=http://localhost:8000

# Flipper WebSocket URL — derived from FLIPPER_API_URL by default.
# Override if your WebSocket endpoint is different (e.g. behind a reverse proxy):
# NEXT_PUBLIC_FLIPPER_WS_URL=ws://localhost:8000

# GGG OAuth2 credentials (for OfficialTradeProvider fallback)
# Register an OAuth2 application at: https://www.pathofexile.com/developer/docs
# GGG_CLIENT_ID=your-client-id
# GGG_CLIENT_SECRET=your-client-secret
# GGG_REDIRECT_URI=http://localhost:3000/api/flipper/auth/callback

# CORS origins for the FastAPI backend (comma-separated). Default: http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
