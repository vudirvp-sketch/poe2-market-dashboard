# PoE2 Market Dashboard — Environment Variables
# Copy this file to .env.local and adjust values as needed.

# POE2Scout API base URL.
# IMPORTANT (KI-15 / KI-31): Use the BARE domain https://poe2scout.com/api.
# The old `api.poe2scout.com` subdomain is DEAD (returns 404 for every endpoint).
# If unset, src/lib/poe2api.ts falls back to this same bare-domain URL.
POE2_API_BASE_URL=https://poe2scout.com/api

# CORS Proxy URL — Cloudflare Worker that proxies poe2scout.com API.
# When the direct API call fails (ECONNRESET, ETIMEDOUT — common from
# Russian IPs), the dashboard automatically retries through this proxy.
#
# To deploy the proxy:
#   1. cd cloudflare-worker/
#   2. npm install -g wrangler && wrangler login
#   3. wrangler deploy
#   4. Copy the output URL here (with /api suffix)
#
# Custom domain (instead of .workers.dev):
#   See cloudflare-worker/wrangler.toml for step-by-step instructions.
#   Summary: add domain to Cloudflare DNS, uncomment routes in wrangler.toml,
#   deploy, then update this URL.
#
# Free tier: 100,000 requests/day — more than enough for personal use.
# Analytics: https://poe2scout-proxy.YOUR-ACCOUNT.workers.dev/__analytics
# If empty/absent, the CORS proxy fallback is disabled.
#
# POE2_CORS_PROXY_URL=https://poe2scout-proxy.your-account.workers.dev/api

# CORS Proxy hint for flipper backend.
# If the flipper backend also cannot reach poe2scout.com (same blocked network),
# set this to your Cloudflare Worker URL so the proxy can include a hint
# in error responses. The backend itself doesn't use this URL — it's just
# a frontend hint for the user.
# FLIPPER_CORS_PROXY_URL=https://poe2scout-proxy.your-account.workers.dev/api

# Flipper backend URL (FastAPI, default: localhost:8000)
FLIPPER_API_URL=http://localhost:8000

# GGG OAuth2 credentials (for OfficialTradeProvider fallback)
# Register an OAuth2 application at: https://www.pathofexile.com/developer/docs
# GGG_CLIENT_ID=your-client-id
# GGG_CLIENT_SECRET=your-client-secret
# GGG_REDIRECT_URI=http://localhost:3000/api/flipper/auth/callback

# CORS origins for the FastAPI backend (comma-separated). Default: http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
