# PoE2 Market Dashboard — Environment Variables
# Copy this file to .env.local and adjust values as needed.

# POE2Scout API base URL.
# IMPORTANT: Use https://api.poe2scout.com/api (with "api." subdomain).
# The bare domain https://poe2scout.com/api causes ECONNRESET errors!
POE2_API_BASE_URL=https://api.poe2scout.com/api

# Flipper backend URL (FastAPI, default: localhost:8000)
# Uncomment if your backend runs on a different host/port:
# FLIPPER_API_URL=http://localhost:8000
